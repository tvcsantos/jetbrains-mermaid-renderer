<idea-plugin>
    <id>com.github.tvcsantos.mermaidrenderer</id>
    <name>Mermaid Renderer</name>
    <vendor url="https://github.com/tvcsantos">tvcsantos</vendor>

    <description><![CDATA[
    Renders <a href="https://mermaid.js.org">Mermaid</a> diagrams inside IntelliJ's
    <b>Rendered Documentation Comments</b>.
    <p>
    A <code>mermaid</code> code block in a KDoc or Javadoc comment is replaced by the rendered
    diagram when the comment is shown in its rendered form (<i>Toggle Rendered View</i>).
    Diagrams are rendered locally with a bundled copy of mermaid.js - no network access, no
    external tools.
    </p>
    ]]></description>

    <depends>com.intellij.modules.lang</depends>
    <!-- Diagrams are rasterized by the embedded browser; without it there is nothing to render. -->
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!--
          DocRenderItemManagerImpl builds every rendered comment through this
          service, so replacing it (the platform marks it open="true") covers the render pass, the
          gutter toggle and refreshes without depending on extension ordering.
        -->
        <applicationService
                serviceInterface="com.intellij.codeInsight.documentation.render.DocRendererProvider"
                serviceImplementation="com.github.tvcsantos.mermaidrenderer.render.MermaidDocRendererProvider"
                overrides="true"/>

        <!-- The same decoration for the hover popup, quick documentation and the tool window. -->
        <projectService
                serviceInterface="com.intellij.lang.documentation.ide.IdeDocumentationTargetProvider"
                serviceImplementation="com.github.tvcsantos.mermaidrenderer.popup.MermaidIdeDocumentationTargetProvider"
                overrides="true"/>

        <!-- Our own gutter icon for a broken diagram; the rendered-comment icon cannot be ours. -->
        <codeInsight.lineMarkerProvider
                language=""
                implementationClass="com.github.tvcsantos.mermaidrenderer.render.MermaidErrorLineMarkerProvider"/>

        <postStartupActivity implementation="com.github.tvcsantos.mermaidrenderer.ServiceOverridesCheck"/>

        <notificationGroup id="Mermaid Renderer" displayType="BALLOON"/>

        <applicationConfigurable
                parentId="tools"
                id="com.github.tvcsantos.mermaidrenderer.settings"
                instance="com.github.tvcsantos.mermaidrenderer.settings.MermaidConfigurable"
                displayName="Mermaid Renderer"/>
    </extensions>

    <applicationListeners>
        <listener class="com.github.tvcsantos.mermaidrenderer.render.MermaidThemeChangeListener"
                  topic="com.intellij.ide.ui.LafManagerListener"/>
        <listener class="com.github.tvcsantos.mermaidrenderer.render.MermaidThemeChangeListener"
                  topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
    </applicationListeners>
</idea-plugin>
